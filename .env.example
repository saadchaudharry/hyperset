# Copy the values you need into your environment (or your host's variable settings).
# None of these are required to run locally; the defaults suit development.

# Security - set these in production
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=myapp.example.com
CSRF_TRUSTED_ORIGINS=https://myapp.example.com

# Database file location (point it at a persistent volume in production)
DATABASE_PATH=/data/db.sqlite3

# Admin user created automatically on start (railway.json start command)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=you@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# Password reset emails (leave EMAIL_HOST empty to print emails to the console)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=HYPERSET <you@gmail.com>

# The Gemini API key and model are NOT set here: add them in the app under Settings -> AI settings.
